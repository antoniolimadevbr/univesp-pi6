              "raw": "{\n  \"ponderacao_frequencia\": \"A\",\n  \"tempo_resposta\": \"Rápido (F - 200ms)\",\n  \"calibracao\": \"Linear\",\n  \"avg_db\": 81.2,\n  \"min_db\": 69.3,\n  \"max_db\": 92.7,\n  \"peak_db\": 96.2,\n  \"latitude\": -23.55052,\n  \"longitude\": -46.633308\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Retorna id', () => pm.expect(j.id).to.be.a('number'));",
                  "pm.collectionVariables.set('medicaoId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar medições",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medicoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "medicoes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('É uma lista', () => pm.expect(j).to.be.an('array'));",
                  "pm.test('Itens têm latitude e longitude', () => {",
                  "  if (j.length) { pm.expect(j[0]).to.have.property('latitude'); pm.expect(j[0]).to.have.property('longitude'); }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter medição por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medicoes/{{medicaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "medicoes",
                "{{medicaoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('ID confere', () => pm.expect(String(j.id)).to.eql(String(pm.collectionVariables.get('medicaoId'))));",
                  "pm.test('Coordenadas numéricas', () => { pm.expect(j.latitude).to.be.a('number'); pm.expect(j.longitude).to.be.a('number'); });",
                  "pm.test('Tipos numéricos nos dB', () => pm.expect(j.avg_db).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter medição inexistente (404)",
